{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitSquid",
  "version": "0.1.0",
  "identifier": "local.gitsquid.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Repository-local Git client assistant",
    "longDescription": "GitSquid indexes one repository, proposes diffs, runs tests, and records every change — with a graph, staging, and commits."
  }
}
