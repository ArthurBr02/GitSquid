# Copy to .env and fill in. .env is git-ignored and never read by anything but this app.
# The app stays usable with every value below unset — see "Degraded mode" in the README.

# Anthropic API key. Without it, model-generated proposals are disabled;
# every other command (index, search, apply, test, record, revert, export) still works.
ANTHROPIC_API_KEY=

# Model used for proposals.
GITSQUID_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max
GITSQUID_EFFORT=high

# Hard cap on the characters of repository context sent with a proposal request.
# Deliberately small: this tool does not buy large-context infrastructure.
GITSQUID_MAX_CONTEXT_CHARS=48000

# Files larger than this are indexed as metadata only, never chunked or sent.
GITSQUID_MAX_FILE_BYTES=200000

# Command run to verify a change. Anything your shell can run.
GITSQUID_TEST_COMMAND=pytest -q

# Seconds before a test run is killed.
GITSQUID_TEST_TIMEOUT=600
